{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "factoryName": { "type": "string" },
    "location": { "type": "string", "defaultValue": "[resourceGroup().location]" },
    "storageAccountId": { "type": "string", "metadata": { "description": "Resource ID of the ADLS Gen2 account" } },
    "databricksWorkspaceUrl": { "type": "string" },
    "databricksWorkspaceId": { "type": "string" },
    "databricksClusterId": { "type": "string" }
  },
  "resources": [
    {
      "type": "Microsoft.DataFactory/factories",
      "apiVersion": "2018-06-01",
      "name": "[parameters('factoryName')]",
      "location": "[parameters('location')]",
      "identity": { "type": "SystemAssigned" }
    },
    {
      "type": "Microsoft.DataFactory/factories/linkedServices",
      "apiVersion": "2018-06-01",
      "name": "[concat(parameters('factoryName'), '/ls_databricks')]",
      "dependsOn": ["[resourceId('Microsoft.DataFactory/factories', parameters('factoryName'))]"],
      "properties": {
        "type": "AzureDatabricks",
        "typeProperties": {
          "domain": "[parameters('databricksWorkspaceUrl')]",
          "authentication": "MSI",
          "workspaceResourceId": "[parameters('databricksWorkspaceId')]",
          "existingClusterId": "[parameters('databricksClusterId')]"
        }
      }
    },
    {
      "type": "Microsoft.DataFactory/factories/pipelines",
      "apiVersion": "2018-06-01",
      "name": "[concat(parameters('factoryName'), '/pl_ingest_landing_file')]",
      "dependsOn": ["[resourceId('Microsoft.DataFactory/factories/linkedServices', parameters('factoryName'), 'ls_databricks')]"],
      "properties": {
        "parameters": {
          "folderPath": { "type": "string" },
          "fileName": { "type": "string" }
        },
        "activities": [
          {
            "name": "merge_landing_file",
            "type": "DatabricksNotebook",
            "policy": { "retry": 3, "retryIntervalInSeconds": 60, "timeout": "0.00:30:00" },
            "linkedServiceName": { "referenceName": "ls_databricks", "type": "LinkedServiceReference" },
            "typeProperties": {
              "notebookPath": "/Shared/ingest_landing_file",
              "baseParameters": {
                "folder_path": { "value": "@pipeline().parameters.folderPath", "type": "Expression" },
                "file_name": { "value": "@pipeline().parameters.fileName", "type": "Expression" }
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.DataFactory/factories/triggers",
      "apiVersion": "2018-06-01",
      "name": "[concat(parameters('factoryName'), '/tr_landing_file_created')]",
      "dependsOn": ["[resourceId('Microsoft.DataFactory/factories/pipelines', parameters('factoryName'), 'pl_ingest_landing_file')]"],
      "properties": {
        "type": "BlobEventsTrigger",
        "typeProperties": {
          "blobPathBeginsWith": "/landing/blobs/orders/",
          "blobPathEndsWith": ".jsonl",
          "ignoreEmptyBlobs": true,
          "scope": "[parameters('storageAccountId')]",
          "events": ["Microsoft.Storage.BlobCreated", "Microsoft.Storage.BlobRenamed"]
        },
        "pipelines": [
          {
            "pipelineReference": { "referenceName": "pl_ingest_landing_file", "type": "PipelineReference" },
            "parameters": {
              "folderPath": "@triggerBody().folderPath",
              "fileName": "@triggerBody().fileName"
            }
          }
        ]
      }
    }
  ]
}
